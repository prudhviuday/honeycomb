{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "honeycomb2",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/q/*"]
  },
  "previews": {}
}
